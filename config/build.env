# ============================================================
# WeOS 构建参数（唯一配置入口，被 build.sh / scripts 读取）
# 修改后无需改动任何脚本。
# ============================================================

# ---------- 发行版标识 ----------
WEOS_NAME="WeOS"
WEOS_FULLNAME="WeOS GNU/Linux"
WEOS_VERSION="1.0"
WEOS_CODENAME="nebula"
WEOS_VENDOR="WeOS Project"

# ---------- 基础系统 ----------
# trixie = Debian 13（稳定，推荐）；forky = Debian testing（滚动，备选）
DEBIAN_SUITE="trixie"
DEBIAN_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/debian"
DEBIAN_SECURITY_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/debian-security"
# 备用镜像（主镜像失败时由脚本自动切换）
DEBIAN_MIRROR_FALLBACK="https://mirrors.ustc.edu.cn/debian"
DEBIAN_SECURITY_MIRROR_FALLBACK="https://mirrors.ustc.edu.cn/debian-security"

# UKUI 4.20 在 Debian 中只存在于 testing/unstable，trixie 缺 session-manager/panel/control-center
UKUI_SUITE="forky"
UKUI_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/debian"

# ---------- 内核（XanMod） ----------
# x64v1 = 2003+ 通用；x64v2 = 2009+；x64v3 = 2015+（Haswell / Zen 及以上，推荐）
KERNEL_ABI="x64v3"
# xanmod = 主线；xanmod-lts = LTS；xanmod-edge = 最新边缘
KERNEL_BRANCH="xanmod"
XANMOD_MIRROR="http://deb.xanmod.org"

# ---------- NVIDIA ----------
# 可选分支：580 / 590 / 595 / 610 / 615（与 XanMod 内核 ABI 匹配的预编译 DKMS 源）
NVIDIA_BRANCH="595"
# proprietary = 闭源专有模块（默认）；open = 开源内核模块
NVIDIA_VARIANT="proprietary"
# 1 = 驱动编译失败时终止构建；0 = 降级为 nouveau 继续出包
NVIDIA_STRICT="1"

# ---------- Wine / Proton ----------
# devel = 最新开发版；staging = 游戏补丁版；stable = 稳定版
WINE_FLAVOR="devel"
WINEHQ_MIRROR="https://dl.winehq.org/wine-builds/debian"
# GE-Proton：latest 自动解析最新版本，也可写死 GE-Proton11-10
PROTON_VERSION="latest"
# GitHub 加速前缀（中国大陆建议启用），留空则直连
GITHUB_PROXY="https://gh-proxy.com/"

# ---------- 镜像策略 ----------
# online   = 构建时直连上游（Debian 走清华镜像，XanMod/WineHQ 直连或走代理）
# snapshot = 先把 XanMod/WineHQ 完整快照到 LOCAL_MIRROR_DIR，再用本地 HTTP 服务供给构建
MIRROR_MODE="online"
LOCAL_MIRROR_DIR="/srv/weos-mirror"
LOCAL_MIRROR_PORT="8399"
# 企业内网有 apt 缓存/代理时填写，例如 http://10.0.0.5:3142
APT_PROXY=""

# ---------- 构建产物 ----------
OUTPUT_DIR="dist"
ISO_BASENAME="weos-${WEOS_VERSION}-amd64"
# 构建并行度
JOBS="$(nproc 2>/dev/null || echo 4)"
